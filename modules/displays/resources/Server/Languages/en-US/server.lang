interactionHints.ADOpen = Open equipment display
items.AD_Armor_Stand_Wood.name = Wood-and-Iron Armor Stand
items.AD_Armor_Stand_Wood.description = A timber and forged-iron display for your chosen equipment. Use to open. Slots from left to right: head, chest, hands, legs, main hand, off hand. Stored equipment keeps its durability and item data.
items.AD_Armor_Stand_Metal.name = Metal Armor Stand
items.AD_Armor_Stand_Metal.description = A steel equipment display for an armory or gun room. Use to open. Slots from left to right: head, chest, hands, legs, main hand, off hand. Stored equipment keeps its durability and item data.
items.AD_Wall_Holder_Wood.name = Wood-and-Iron Wall Weapon Holder
items.AD_Wall_Holder_Wood.description = Mount on a solid wall and use to store and display one weapon. Accepts native weapon items, including compatible modded guns.
items.AD_Wall_Holder_Metal.name = Metal Wall Weapon Holder
items.AD_Wall_Holder_Metal.description = A steel wall mount for one weapon or compatible modded gun. Mount on a solid wall and use to open.
items.AD_Wall_Rack_Wood.name = Wood-and-Iron Wall Weapon Rack
items.AD_Wall_Rack_Wood.description = A wide timber wall rack for three weapons or compatible modded guns. Use to open. Inventory slots run bottom, middle, top.
items.AD_Wall_Rack_Metal.name = Metal Wall Gun Rack
items.AD_Wall_Rack_Metal.description = A steel gun-room rack for three weapons or compatible modded guns. Mount on a solid wall and use to open. Inventory slots run bottom, middle, top.
