items.CG_Glass_Block.name = Clear Glass
items.CG_Glass_Block.description = Craft any sand directly into clear glass at the Builder's Workbench, Windows category. Shape six glass blocks into sixteen panes at the same bench.
items.CG_Glass_Pane.name = Clear Glass Pane
items.CG_Glass_Pane.description = A thin clear pane. Connects to neighboring clear glass panes and blocks. Craft at the Builder's Workbench, Windows category.
